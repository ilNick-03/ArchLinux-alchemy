{
    // --- WAYBAR DEFAULT MODULES DEFINITION --- //

    // Brightness display
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false,

        // SCROLL up/down to increase/decrease brightness by 5%
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",

        // LEFT CLICK: Increase brightness by 5%
        "on-click": "brightnessctl set 5%-",
        // RIGHT CLICK: Decrease brightness by 5%
        "on-click-right": "brightnessctl set +5%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% 󱊣",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""],

        // --- TOOLTIP CONFIGURATION ---
        "tooltip": true,    // Enable tooltip rendering
        "tooltip-format-discharging": "      Empty in:  {time}\n   Energy rate:  {power} W\nBattery health:  {health}%",
        "tooltip-format-charging": "       Full in:  {time}\n   Energy rate:  {power} W\nBattery health:  {health}%",
        "tooltip-format-full": "Fully charged  󱊣\nBattery health:  {health}%",
        "tooltip-format": "{capacity}%\nEnergy rate: {power} W\nBattery health: {health}%"
    },

    "bluetooth": {
        "format-disabled": "BT Disabled 󰂲",
        "format-off": "BT Off ",
        "format-on": "BT Ready ",
        "format-discoverable": "Scanning... ",
        "format-connected": "BT ",
        "format-connected-battery": "BT, {device_battery_percentage}% ",

        // --- TOOLTIP CONFIGURATION ---
        "tooltip": true,    // Replace with "false" to disable tooltip
        "tooltip-format-disabled": "BT Offline 󰂲",
        "tooltip-format-off": "BT Offline ",
        "tooltip-format-on": "{controller_alias}\nMAC: {controller_address}\n\nStatus: Ready (No devices connected)",
        "tooltip-format-connected": "{controller_alias}\nMAC: {controller_address}\n\nConnected ({num_connections}):\n{device_enumerate}",
        // Enumeration of individual devices
        "tooltip-format-enumerate-connected": "󰂱 {device_alias}\t[{device_address}]",
        "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias}\t{device_battery_percentage}%",

        // LEFT CLICK: Toggle Bluetooth On/Off
        "on-click": "rfkill toggle bluetooth",
        // RIGHT CLICK: Open bluetooth manager
        "on-click-right": "blueman-manager"
    },

    "clock": {
        // "format": "{:%H:%M}",    // 24h format  (e.g., 13:45)
        "format": "{:%I:%M %p}",    // 12h format with AM/PM    (e.g., 01:45 PM)
        
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",

        //  Alternative Views (Toggle on click)
        
        // [EUROPEAN STYLE]
        // "format-alt": "{:%d-%m-%Y}",                  // Day-Month-Year (15-05-2026)
        "format-alt": "{:%d/%m/%Y}",                     // Day/Month/Year with slashes
        // "format-alt": "{:%a, %d %b}",                 // Weekday, Day Month (Fri, 15 May)

        // [US / INTERNATIONAL STYLE]
        // "format-alt": "{:%Y-%m-%d}",                  // ISO-8601 Standard (2026-05-15)
        // "format-alt": "{:%m/%d/%Y}",                  // Month/Day/Year (US style)
        // "format-alt": "{:%B %d, %Y}",                 // Full Month Day, Year (May 15, 2026)

        // [DETAILED / VERBOSE]
        // "format-alt": "{:%A, %B %d, %Y (%R)}",        // Full Day, Month Day, Year + 24h Time
        // "format-alt": "Week %V - %A",                 // Week number and Full Day name
        
        // [CYBERPUNK / MINIMALIST]
        // "format-alt": "󰃭  {:%d·%m·%y}",               // Minimal with Icon and Dots
        // "format-alt": "{:%H:%M:%S}",                  // Just show seconds for precision
        // "format-alt": "{:%j/365}",                    // Day of the year (Julian date)
        
        // [TECHNICAL]
        // "format-alt": "{:%s}",                        // Unix Timestamp (seconds since 1970)
        // "format-alt": "UTC {:%H:%M} 󰓅",               // Could be useful for servers/devs
    },

    "cpu": {
        "format": "{usage}% ",
        "interval": 10,           
        "tooltip": true,
        "tooltip-format": "󰻠 CPU Overview\n\nAvg Freq: {avg_frequency} GHz\nMax Freq: {max_frequency} GHz",
        "on-click": "alacritty -T \"BTOP (Process Monitor)\" --class floating_monitor -e btop"
    },

    // Activated   = always-on screen
    // Deactivated = auto suspend
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
        },
        
    "tooltip-format-activated": "Always-on screen",
    "tooltip-format-deactivated": "Auto suspend"
    },

    // RAM Usage
    "memory": {
        "format": "{}% ",
        "interval": 30,           // Increased interval to mitigate polling overhead
        "tooltip": true,          // Enable tooltip rendering
        "tooltip-format": "󰍛 RAM Overview\nUsed:       {used:0.1f} GiB / {total:0.1f} GiB  ({percentage}%)\nAvailable:  {avail:0.1f} GiB\n\n󰓡 Swap Usage\nUsed:       {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB  ({swapPercentage}%)",

        "on-click": "alacritty -T \"BTOP (Process Monitor)\" --class floating_monitor -e btop"
    },

    // Which audio is playing now?
    //  For displaying 'mpv' playback, you need 'mpv-mpris'
    "mpris": {
        "format": "{player_icon} {status_icon}",
        "format-paused": "{player_icon} {status_icon}",
        "player-icons": {
            "default": "󰎆",
            "spotify": "",
            "firefox": "",
            "librewolf": "",
            "chrome": "",
            "chromium": "",
            "mpv": "󰎆",
            "vlc": "󰕼"    

        },
        "status-icons": {
            // "playing": "󰐊",
            "paused": "󰏤"
        },
        
	    "tooltip": true,
	    "tooltip-format": "{player} - {status}\n{artist} - {album}",

        /* Mouse Actions */
	    "on-click": "playerctl play-pause",
	    "on-click-right": "playerctl next"
    },

    "network": {
        "format-disabled": "Network Off 󰯡",
        "format-disconnected": "Searching... 󱛄",
        "format-ethernet": "Ethernet ",
        "format-wifi": "Wi-Fi ",
        
        // --- TOOLTIP CONFIGURATION ---
        "tooltip": true,    // Replace with "false" to disable tooltip
        "tooltip-format-wifi": "{essid} ({signalStrength}%)   \nIP: {ipaddr}",
        "tooltip-format-ethernet": "Ethernet ({ifname})  \nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected ⚠",
        "tooltip-format-disabled": "Offline 󰯡",


        // LEFT CLICK: Toggles Wi-Fi radio (Switch between On/Off)
        "on-click": "nmcli radio wifi $(nmcli radio wifi | grep -q 'enabled' && echo 'off' || echo 'on')",
        // RIGHT CLICK: Open manager in floating window
        "on-click-right": "~/.config/hypr/scripts/wifi-menu.sh"
    },

    // Power profiles daemon configuration
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "default": " ",
            "performance": " ",
            "balanced": "  ",
            "power-saver": "  "
        },
        "min-length": 3,

        // --- TOOLTIP CONFIGURATION ---
        "tooltip": true,    // Enable tooltip rendering
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",

        // SCROLL up/down to change the current profile (power-saver -> balanced -> performance)
        "on-scroll-up": "powerprofilesctl set $(powerprofilesctl get | awk '/power-saver/{print \"balanced\"} /balanced/{print \"performance\"} /performance/{print \"power-saver\"}')",
        "on-scroll-down": "powerprofilesctl set $(powerprofilesctl get | awk '/performance/{print \"balanced\"} /balanced/{print \"power-saver\"} /power-saver/{print \"performance\"}')"
    },

    // Microphone privacy module
    "privacy#mic": {
        "icon-spacing": 4,
        "icon-size": 15,
        "transition-duration": 250,
        "modules": [
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ]
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "Muted ",
        "format-icons": {
            "headphone": "",
            "hands-free": " 󰍮",
            "headset": "",
            "default": ["", "", ""]
        },

        // LEFT CLICK: Toggle Mute/Unmute (restores previous volume)
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        // RIGHT CLICK: Open audio control panel
        "on-click-right": "pavucontrol",

        // SCROLL up/down to increase/decrease volume by 2%.  Max: 100%
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "interval": 20,                       
        "tooltip": false,
        "on-click": "alacritty -T \"BTOP (Process Monitor)\" --class floating_monitor -e btop"
    },

    "tray": {
        "spacing": 10
    }
}
